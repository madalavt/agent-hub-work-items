# ===================================================
# Agent Hub Work Item Manager API (.env)
# ===================================================

# Database connection
# Default: zero-config SQLite database in ./data/work_items.db
DATABASE_URL=sqlite:///./data/work_items.db

# For Production (PostgreSQL with PgBouncer transaction pooling):
# DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@localhost:6432/work_items
# DIRECT_DATABASE_URL=postgresql+psycopg://agent_hub:agent_hub@localhost:5432/work_items
# DB_READ_URL=postgresql+psycopg://agent_hub:agent_hub@read-replica:5432/work_items

# Service API Key (callers send as X-API-Key or Ocp-Apim-Subscription-Key)
API_KEY=test-api-key

# Annotations Service URL (for linked documents)
ANNOTATIONS_API_URL=http://localhost:8004
ANNOTATIONS_API_KEY=test-api-key

# Demo Queues & Items (set to false for clean production environments)
SEED_DEMO_DATA=false
SEED_DEFAULT_QUEUES=true

# Throughput and Database Pool Tuning
WEB_CONCURRENCY=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Retention and Auto-Cleanup (days before completed items are eligible for pruning)
RETENTION_DAYS=180
RETIRE_BATCH_SIZE=2000

# Default queue attempt budget
DEFAULT_MAX_ATTEMPTS=3

# Allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]
